load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "perception_application",
    srcs = [
        "src/common.cpp",
        "src/perception_application.cpp",
    ],
    hdrs = glob(["include/*.h"]),
    copts = [
        "-Wall",
        "-Wextra",
        "-Wpedantic",
    ],
    includes = ["include"],
    deps = [
        "@traffic_ipc//:traffic_ipc",
        "@score_baselibs//score/language/futurecpp",
        "@score_baselibs//score/mw/log:frontend",
        "@score_lifecycle//score/launch_manager:lifecycle_cc",
    ],
)

cc_binary(
    name = "demo_perception",
    srcs = ["src/main.cpp"],
    linkopts = select({
        "@platforms//os:linux": ["-lpthread"],
        "//conditions:default": [],
    }),
    deps = [
        ":perception_application",
        "@score_baselibs//score/mw/log",
        "@score_lifecycle//score/launch_manager:lifecycle_cc",
    ],
)
