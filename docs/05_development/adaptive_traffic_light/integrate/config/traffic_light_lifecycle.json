{
    "schema_version": 1,
    "defaults": {
        "deployment_config": {
            "bin_dir": "/tmp/linux_rt_application/bin",
            "ready_timeout": 90.0,
            "shutdown_timeout": 60.0,
            "ready_recovery_action": {
                "restart": {
                    "number_of_attempts": 1,
                    "delay_before_restart": 0.1
                }
            },
            "recovery_action": {
                "switch_run_target": {
                    "run_target": "fallback_run_target"
                }
            },
            "sandbox": {
                "scheduling_policy": "SCHED_RR",
                "scheduling_priority": 50
            }
        },
        "component_properties": {
            "application_profile": {
                "application_type": "Reporting",
                "is_self_terminating": false
            },
            "ready_condition": {
                "process_state": "Running"
            }
        },
        "run_target": {
            "transition_timeout": 180.0,
            "recovery_action": {
                "switch_run_target": {
                    "run_target": "fallback_run_target"
                }
            }
        }
    },
    "components": {
        "control_daemon": {
            "description": "State manager for traffic-light Run Target transitions",
            "component_properties": {
                "binary_name": "control_daemon",
                "application_profile": {
                    "application_type": "State_Manager",
                    "alive_supervision": {
                        "min_indications": 0
                    }
                }
            },
            "deployment_config": {
                "ready_timeout": 30.0,
                "shutdown_timeout": 30.0,
                "environmental_variables": {
                    "PROCESSIDENTIFIER": "control_daemon"
                }
            }
        },
        "traffic_perception": {
            "description": "Real camera/video inference process publishing TrafficSnapshot values",
            "component_properties": {
                "binary_name": "traffic_perception",
                "application_profile": {
                    "application_type": "Reporting_And_Supervised",
                    "alive_supervision": {
                        "reporting_cycle": 10.0,
                        "min_indications": 2,
                        "max_indications": 6,
                        "failed_cycles_tolerance": 2
                    }
                }
            },
            "deployment_config": {
                "ready_timeout": 120.0,
                "shutdown_timeout": 120.0,
                "sandbox": {
                    "scheduling_policy": "SCHED_RR",
                    "scheduling_priority": 70
                },
                "environmental_variables": {
                    "PROCESSIDENTIFIER": "traffic_perception",
                    "IDENTIFIER": "traffic_perception",
                    "MW_LOG_CONFIG_FILE": "/tmp/linux_rt_application/etc/perception_logging.json",
                    "TPER_ROOT": "/tmp/linux_rt_application",
                    "LD_LIBRARY_PATH": "/tmp/linux_rt_application/lib",
                    "DISPLAY": ":0",
                    "WAYLAND_DISPLAY": "wayland-0",
                    "XDG_RUNTIME_DIR": "/run/user/0"
                }
            }
        },
        "timing_decision": {
            "description": "Adaptive traffic timing decision process",
            "component_properties": {
                "binary_name": "traffic_timing_decision",
                "depends_on": [
                    "traffic_perception"
                ],
                "application_profile": {
                    "application_type": "Reporting_And_Supervised",
                    "alive_supervision": {
                        "reporting_cycle": 2.0,
                        "min_indications": 2,
                        "max_indications": 4,
                        "failed_cycles_tolerance": 1
                    }
                }
            },
            "deployment_config": {
                "ready_timeout": 60.0,
                "shutdown_timeout": 60.0,
                "sandbox": {
                    "scheduling_policy": "SCHED_RR",
                    "scheduling_priority": 60
                },
                "environmental_variables": {
                    "PROCESSIDENTIFIER": "timing_decision",
                    "IDENTIFIER": "timing_decision",
                    "MW_LOG_CONFIG_FILE": "/tmp/linux_rt_application/etc/timing_decision_logging.json",
                    "TIMING_REPORT_LOG_DIR": "/tmp/linux_rt_application/logs"
                }
            }
        },
        "traffic_signal_controller": {
            "description": "Real-time signal FSM and output controller consuming TimingPlanMessageV1",
            "component_properties": {
                "binary_name": "traffic_signal_controller",
                "depends_on": [
                    "timing_decision"
                ],
                "application_profile": {
                    "application_type": "Reporting_And_Supervised",
                    "alive_supervision": {
                        "reporting_cycle": 2.0,
                        "min_indications": 2,
                        "max_indications": 6,
                        "failed_cycles_tolerance": 2
                    }
                }
            },
            "deployment_config": {
                "ready_timeout": 60.0,
                "shutdown_timeout": 60.0,
                "sandbox": {
                    "scheduling_policy": "SCHED_RR",
                    "scheduling_priority": 50
                },
                "environmental_variables": {
                    "PROCESSIDENTIFIER": "traffic_signal_controller",
                    "IDENTIFIER": "traffic_signal_controller",
                    "MW_LOG_CONFIG_FILE": "/tmp/linux_rt_application/etc/signal_control_logging.json",
                    "TRAFFIC_SIGNAL_CONTROLLER_FSM_PRIORITY": "80",
                    "TRAFFIC_SIGNAL_CONTROLLER_ANALYTICS_LOG_FILE": "/tmp/linux_rt_application/logs/CTRL.dlt",
                    "TRAFFIC_SIGNAL_CONTROLLER_ANALYTICS_REPORT_FILE": "/tmp/linux_rt_application/logs/signal_control_analytics_report.txt"
                }
            }
        }
    },
    "run_targets": {
        "Startup": {
            "description": "Only the state manager is active",
            "depends_on": [
                "control_daemon"
            ]
        },
        "Running": {
            "description": "Run the ordered Perception -> Timing Decision -> Signal Control pipeline",
            "transition_timeout": 180.0,
            "depends_on": [
                "control_daemon",
                "traffic_perception",
                "timing_decision",
                "traffic_signal_controller"
            ]
        }
    },
    "initial_run_target": "Startup",
    "alive_supervision": {
        "evaluation_cycle": 0.1
    },
    "fallback_run_target": {
        "description": "Keep control available after an application failure",
        "depends_on": [
            "control_daemon"
        ],
        "transition_timeout": 120.0
    }
}
