load("@rules_cc//cc:defs.bzl", "cc_import", "cc_library")

package(default_visibility = ["//visibility:public"])

# Export the actual shared object as a Bazel file so sh_binary(data=...)
# can copy it into the runtime bundle.
exports_files([
    "lib/libonnxruntime.so.1",
])

cc_import(
    name = "onnxruntime_so",
    shared_library = "lib/libonnxruntime.so.1",
)

cc_library(
    name = "headers",
    hdrs = glob(["include/**/*.h"]),
    includes = ["include"],
)

cc_library(
    name = "onnxruntime",
    deps = [
        ":headers",
        ":onnxruntime_so",
    ],
)

# File target used by deployment scripts.
filegroup(
    name = "onnxruntime_runtime",
    srcs = [
        "lib/libonnxruntime.so.1",
    ],
)
