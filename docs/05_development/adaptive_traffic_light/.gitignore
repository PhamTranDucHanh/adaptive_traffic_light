# ==============================================================================
# 1. Build Directories
# ==============================================================================
# Exclude common build output directories
**/[Bb]uild/

# Specific exclusions for CMake artifacts
CMakeCache.txt
CMakeFiles/
CMakeSettings.json
CMakePresets.json
CTestTestfile.cmake
cmake_install.cmake
Makefile
targets/
etc/

# ==============================================================================
# 2. Compilation Database & LSP Configuration
# ==============================================================================
# Keep compile_commands.json at the root for local LSP analysis.
# Exclude temporary cache and generated IDE configuration files.
.clangd/
.cache/
.ccls-cache/

# IDE
**/.vscode/

# Project Output
**/output/
**/output-*/
.aider*

# Bazel
bazel-*
.bazelrc.user
MODULE.bazel.lock 

# Bazel cache
.cache/
.bazel/

*.dat
*.data 

# Bazel vendor
vendor/

# Ignore stray .txt but keep CMake's build scripts
*.txt
!CMakeLists.txt
!**/CMakeLists.txt
!requirements.txt

bazel-*

# Generated/downloaded runtime dependencies. BUILD metadata remains tracked.
data/*.mp4
data/*.onnx
traffic_perception/lib/onnxruntime/