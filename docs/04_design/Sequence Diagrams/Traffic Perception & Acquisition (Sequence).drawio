  <diagram id="wXhUrOOsDCytNieNQsu0" name="error">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nautonumber\n\ntitle Traffic Perception &amp; Acquisition - Full Error Propagation Paths\n\nparticipant \&quot;StreamWorker [lane]\&quot; as WRK\nqueue \&quot;Frame Queue [lane]\&quot; as Q\nparticipant InferenceEngine as ENG\nparticipant TrafficAnalyzer as ANZ\nparticipant SnapshotPublisher as PUB\nparticipant Logger as LOG\nactor Manager as User\n\nalt SCENARIO 1: INPUT/INGESTION ERROR (RTSP STREAM DROP / CORRUPTED FRAME)\n    note over WRK: [Unified Downstream Error Propagation Pipeline Architecture]\n    note over WRK: Stream Capture Timeout\\nor Empty Frame Detected!\n    activate WRK\n    WRK -&gt; WRK ++: Create Fake/Tombstone FrameData\\nMark Status = ERR_STREAM_DROP\n    return\n\n    WRK -&gt;&gt; Q: enqueue(failedFrameData)\n    deactivate WRK\n    activate Q\n\n    ENG -&gt; Q: dequeue()\n    activate ENG\n    Q --&gt;&gt; ENG: failedFrameData\n    deactivate Q\n\n    opt Status == ERR_STREAM_DROP\n      note over ENG: Bypass GPU Inference Execution\n      ENG -&gt;&gt; ANZ: forwardDetections(failedFrameData)\n      deactivate ENG\n      activate ANZ\n    end\n\n    \n    note over ANZ: Status == ERR_STREAM_DROP\\nBypass Tracking &amp; Analysis\n    ANZ -&gt;&gt; PUB: forwardLaneMetrics(failedFrameData)\n    deactivate ANZ\n    activate PUB\n\n    note over PUB: Skip broadcasting to Module 2\\nExtract Error Context: STREAM_DROP\n\n    PUB -&gt;&gt; PUB: calculateTelemetryMetadata(Status: ERR_STREAM_DROP)\n      activate PUB\n      deactivate PUB\n\n    note over PUB: Increment Drop-Frame Rate\n    PUB -&gt; LOG: logError(STREAM_DOWN, LaneID)\n    activate LOG\n    deactivate PUB\n    LOG --&gt;&gt; User: Error Log\n    activate User\n    deactivate LOG\n    deactivate User\n\n\n&#39; =====================================================================\n\nelse SCENARIO 2: CORE AI ERROR (INFERENCE TIMEOUT / GPU OUT OF MEMORY)\n\n    note over WRK: Ingestion Success (Happy Path Entry)\n    activate WRK\n    WRK -&gt;&gt; Q: enqueue(validFrameData)\n    deactivate WRK\n    activate Q\n\n    ENG -&gt; Q: dequeue()\n    activate ENG\n    Q --&gt;&gt; ENG: validFrameData\n    deactivate Q\n\n    opt Execution Fault\n      note over ENG: AI Model Timeout / GPU OOM detected!\\nModify FrameMetadata.Status = ERR_INFERENCE_TIMEOUT\n      ENG -&gt;&gt; ANZ: forwardDetections(failedFrameData)\n      deactivate ENG\n      activate ANZ\n    end\n\n    opt Status == ERR_INFERENCE_TIMEOUT\n      note over ANZ: Bypass Tracking &amp; Analysis\n      ANZ -&gt;&gt; PUB: forwardLaneMetrics(failedFrameData)\n      deactivate ANZ\n      activate PUB\n    end\n\n    note over PUB: Skip broadcasting to Module 2\n    \n    PUB -&gt;&gt; PUB: calculateTelemetryMetadata(Status: ERR_INFERENCE_TIMEOUT)\n      activate PUB\n      deactivate PUB\n    note over PUB, LOG: Log GPU Metrics &amp; Error State\n    PUB -&gt;&gt; LOG: logError(INFERENCE_TIMEOUT)\n    activate LOG\n    deactivate PUB\n    LOG --&gt;&gt; User: Error Log\n    activate User\n    deactivate LOG\n    deactivate User\n    \nend\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="YpqXrJLo6o5rR7ObxuXz-77">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=20;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
