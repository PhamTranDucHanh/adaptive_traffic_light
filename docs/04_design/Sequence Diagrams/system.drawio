<mxfile host="app.diagrams.net">
  <diagram name="Page-1" id="K_ZTr44DlPa_CnjdC5Np">
    <mxGraphModel grid="1" page="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\ntitle Application-Level Sequence Diagram\n\nautonumber\n\nparticipant \&quot;Traffic Perception\\n&amp; Acquisition\&quot; as Vision\nqueue \&quot;Snapshot Queue\&quot; as SnapQ\nparticipant \&quot;Traffic Timing\\nDecision\&quot; as Decision\nparticipant \&quot;Traffic Signal\\nController (FSM)\&quot; as FSM\nparticipant \&quot;Analytics\\nService\&quot; as Analytics\nactor \&quot;Manager\&quot; as Manager\nactor \&quot;Traffic Participant\&quot; as User\n\nactivate Vision\n\nnote right of Vision\n- Capture camera frames\n- Inference traffic frames\n- Detect vehicles\n- Estimate traffic metrics\nend note\n\n\n\nalt Vision operating normally\n\n    Vision -&gt;&gt; SnapQ : publishTrafficSnapshot()\nactivate SnapQ\n    Vision -&gt;&gt; Manager : Display multi-lane view\n    activate Manager\n    deactivate Vision\n    \n    deactivate Manager\n\nelse Vision error\n    Vision -&gt;&gt; Manager : Report error\n    activate Vision\n    activate Manager\n    deactivate Vision\n    deactivate Manager\n\nend\n\n\n\n\nDecision -&gt; SnapQ : SnapshotRequest()\nactivate Decision\nSnapQ --&gt;&gt; Decision : TrafficSnapshot\ndeactivate SnapQ\n\nnote right of Decision\n- Validate snapshot \n- Detect emergency requests\n- Estimate traffic demand\n- Generate TimingPlan\n- And publish TimingPlan\nend note\n\nDecision -&gt; FSM : publishTimingPlan()\n\nactivate FSM\n\nFSM --&gt;&gt; Decision : ACK / NACK\ndeactivate Decision\n\nnote right of FSM\n- Execute TimingPlan from Plan Receiver\n- Control signal phases (RED/YELLOW/GREEN)\n- Handle emergency preemption\n- Collect execution timestamp\n- Simulate signal display output\nend note \nFSM -&gt; User : Traffic signal states\nactivate User\n\nFSM -&gt; Analytics : publishExecutionStatistics()\n\ndeactivate FSM\n\n\nactivate Analytics\n\nnote right of Analytics\n- Analyze signal timing \n- Present dashboard insights to manager \n- Trigger alerts on threshold violation\n- Generate performance reports\nend note\n\nAnalytics -&gt; Manager : Dashboard / Reports / Alerts\ndeactivate Analytics\nactivate Manager\ndeactivate Manager\ndeactivate User\n\n\n@enduml&quot;,&quot;format&quot;:&quot;svg&quot;}" id="9FkAYh4zOH2huxU83_XE-1">
          <mxCell parent="1" style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1">
            <mxGeometry height="928" width="1225" x="20" y="1020" as="geometry" />
          </mxCell>
        </UserObject>
      </root>
    </mxGraphModel>
  </diagram>
