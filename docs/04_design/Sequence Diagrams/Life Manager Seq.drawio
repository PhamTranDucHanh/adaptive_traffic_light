        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\ntitle Process Startup, Monitoring and Recovery\n\nautonumber\nhide footbox\n\nparticipant \&quot;Application\\n(main)\&quot; as App\nparticipant \&quot;Process Launcher\&quot; as Launcher\nparticipant \&quot;Health Monitor\&quot; as Monitor\n\nparticipant \&quot;Traffic Signal\\nController\&quot; as FSM\nparticipant \&quot;Traffic Timing\\nDecision\&quot; as Decision\nparticipant \&quot;Traffic Perception\&quot; as Vision\nparticipant \&quot;Analytics\&quot; as Analytics\n\n== System Startup ==\n\nactivate App\n\nApp -&gt; App : loadConfiguration()\nactivate App\nApp --&gt;&gt; App: ConfigStatus\ndeactivate App\n \nApp -&gt; App : initializeIPC()\nactivate App\nApp --&gt;&gt; App: ipcStatus\ndeactivate App\n\nApp -&gt; Launcher : launchProcesses()\n\nactivate Launcher\n\ngroup Launch Traffic Signal Controller\n\nLauncher -&gt; Launcher : fork()+exec(FSM)\nactivate Launcher\nLauncher --&gt;&gt; Launcher : fsmPid\ndeactivate Launcher \n\nLauncher -&gt; FSM : start()\n\nactivate FSM\nFSM --&gt;&gt; Launcher : Ready(PID)\n\nend\n\ngroup Launch Traffic Timing Decision\n\nLauncher -&gt; Launcher : fork()+exec(Decision)\n\nactivate Launcher\nLauncher --&gt;&gt; Launcher : decisionPid\ndeactivate Launcher \n\nLauncher -&gt; Decision : start()\n\nactivate Decision\nDecision --&gt;&gt; Launcher : Ready(PID)\n\nend\n\ngroup Launch Traffic Perception\n\nLauncher -&gt; Launcher : fork()+exec(Vision)\nactivate Launcher\nLauncher --&gt;&gt; Launcher : visionPid \ndeactivate Launcher \nLauncher -&gt; Vision : start()\n\nactivate Vision\nVision --&gt;&gt; Launcher : Ready(PID)\n\nend\n\ngroup Launch Analytics\n\nLauncher -&gt; Launcher : fork()+exec(Analytics)\nactivate Launcher\nLauncher --&gt;&gt; Launcher : analyticsPid \ndeactivate Launcher \n\nLauncher -&gt; Analytics : start()\n\nactivate Analytics\nAnalytics --&gt;&gt; Launcher : Ready(PID)\n\nend\n\nLauncher -&gt; Launcher : storeProcessInfo()\nactivate Launcher\nLauncher --&gt;&gt; Launcher : processTableUpdated \ndeactivate Launcher \n\nLauncher --&gt;&gt; App : ProcessInfo\n\ndeactivate Launcher\n\nApp -&gt;&gt; Monitor : registerProcesses(ProcessInfo)\n\nactivate Monitor\nMonitor -&gt; Monitor : initializeWatchList()\nactivate Monitor\nMonitor --&gt;&gt; Monitor : watchlistInitialized \ndeactivate Monitor\n\n== Normal Runtime ==\n\nloop runApp = true\n\nVision -&gt;&gt; Monitor : HealthReporting()\n\nDecision -&gt;&gt; Monitor : HealthReporting()\n\nFSM -&gt;&gt; Monitor : HealthReporting()\n\nAnalytics -&gt;&gt; Monitor : HealthReporting()\n\nMonitor -&gt; Monitor : updateHeartbeatTable()\nactivate Monitor\nMonitor --&gt;&gt; Monitor : heartbeatUpdated \ndeactivate Monitor\n \nMonitor -&gt; Monitor : checkHeartbeatTimeout()\nactivate Monitor\nMonitor --&gt;&gt; Monitor : timeoutStatus \ndeactivate Monitor\n\n\nend\n\n== Failure Detection ==\n\nopt Decision heartbeat timeout\n\nMonitor -&gt; Monitor : markProcessFailed()\nactivate Monitor\nMonitor --&gt;&gt; Monitor : markedProcessID\ndeactivate Monitor\n\nMonitor -&gt; Launcher : restartProcess(markedProcessID)\n\nactivate Launcher\n\nLauncher -&gt; Launcher : terminateProcess()\nactivate Launcher\nLauncher --&gt;&gt; Launcher : processTerminated\ndeactivate Launcher\n\nLauncher -&gt;&gt; Decision : terminate()\ndeactivate Decision\n\nLauncher -&gt; Launcher : fork()+exec(Decision)\nactivate Launcher\nLauncher --&gt;&gt; Launcher : decisionPid\ndeactivate Launcher \n\nLauncher -&gt; Decision : start()\n\nactivate Decision\nDecision --&gt;&gt; Launcher : Ready(PID)\n\nLauncher -&gt; Launcher : updateProcessTable()\nactivate Launcher\nLauncher --&gt;&gt; Launcher : processTableUpdated\ndeactivate Launcher\n\nLauncher -&gt;&gt; Monitor : restartCompleted()\n\ndeactivate Launcher\n\nend\n\n== Normal Shutdown ==\n\nApp -&gt; Launcher : terminateAll()\n\nactivate Launcher\n\nLauncher -&gt;&gt; Analytics : terminate()\ndeactivate Analytics\n\nLauncher -&gt;&gt; Vision : terminate()\ndeactivate Vision\n\nLauncher -&gt;&gt; Decision : terminate()\ndeactivate Decision\n\nLauncher -&gt;&gt; FSM : terminate()\ndeactivate FSM\n\nLauncher --&gt;&gt; App : terminateStatus\n\ndeactivate Launcher\ndeactivate App\ndeactivate Monitor\n\n\n@enduml&quot;,&quot;format&quot;:&quot;svg&quot;}" id="n7iwfH1e3T67pBIVLNbX-1">
