        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle Traffic Signal Controller \nactor \&quot;Life Cycle Manager\&quot; as LC\nactor \&quot;Traffic Decision Engine\&quot; as A\nparticipant \&quot;Health Reporter\&quot; as HR\nparticipant \&quot;Plan Receiver\&quot; as PR\nparticipant \&quot;Signal FSM Engine\&quot; as FSM \nparticipant \&quot;Output Simulator\&quot; as OS\nparticipant \&quot;Publisher Collector\&quot; as PC\nparticipant \&quot;Logger\&quot; \nparticipant \&quot;Analytics\&quot;\nactor \&quot;Traffic Participants\&quot; as TP\n\nA -&gt; PR : TimingPlan \nactivate A\nactivate PR\nPR -&gt; PR : validPlan()\nactivate PR\nPR --&gt;&gt; PR : validPlanResult\ndeactivate PR\nalt plan invalid \n   PR -&gt; PR: reject()\n   activate PR\n   PR --&gt;&gt; PR : rejectResult\n   deactivate PR\n   PR --&gt;&gt; A : N A C K\nelse plan valid\n   PR -&gt; PR : accept()\n   activate PR\n   PR --&gt;&gt; PR : acceptResult\n   deactivate PR\n   PR --&gt;&gt; A : A C K\n   deactivate A\n   PR -&gt; FSM : PlanData(newPlan)\nend\ndeactivate PR\n\nloop tick_due == 1\n    FSM -&gt; FSM : waitTick()\n    activate FSM\n    alt emergency plan\n        FSM -&gt; FSM : updatePlan()\n        activate FSM\n        FSM --&gt;&gt; FSM : planUpdated\n        deactivate FSM\n    else no emergency plan\n        alt remaining time &gt; 0 \n            FSM -&gt; FSM : keepState()\n            activate FSM\n            FSM --&gt;&gt; FSM : stateKept\n            deactivate FSM\n        else remaining time == 0\n            alt new plan available\n                FSM -&gt; FSM : updatePlan()\n                activate FSM\n                FSM --&gt;&gt; FSM : planUpdated\n                deactivate FSM\n            else no new plan\n                note right: keep current plan\n            end\n        end\n    end\n    FSM -&gt; FSM : fsm()\n    activate FSM\n    FSM --&gt;&gt; FSM : fsmResult\n    deactivate FSM\n    FSM -&gt;&gt; PC : SignalOutput\n    activate PC\n    FSM -&gt;&gt; OS : SignalDisplay\n    deactivate FSM\n    activate OS\n    PC -&gt; PC : collectTimestamp()\n    activate PC\n    PC --&gt;&gt; PC : timestampCollected\n    deactivate PC\n    opt cycle completed \n        PC -&gt; PC : packageData()\n        activate PC\n        PC --&gt;&gt; PC : dataPackaged\n        deactivate PC\n        PC -&gt; B : DataCollect\n        activate B\n        deactivate B\n    end\n    deactivate PC\n    OS -&gt; OS : formatConsole()\n    activate OS\n    OS --&gt;&gt; OS : consoleFormatted\n    deactivate OS\n    activate TP\n    OS -&gt; TP : Console\n    deactivate TP\n    deactivate OS\nend\nloop heartbeat_due == 1\n    LC -&gt; HR : HeartbeatRequest\n    activate LC\n    activate HR\n    HR -&gt;&gt; Timer : requestHeartbeat()\n    activate Timer\n    Timer --&gt;&gt; HR : Heartbeat\n    deactivate Timer\n    HR -&gt;&gt; FSM : requestHeartbeat()\n    activate FSM\n    FSM --&gt;&gt; HR : Heartbeat\n    deactivate FSM\n    HR -&gt;&gt; PC : requestHeartbeat()\n    activate PC\n    PC --&gt;&gt; HR : Heartbeat\n    deactivate PC\n    HR -&gt; HR : evaluateHealth()\n    activate HR\n    HR --&gt;&gt; HR : healthEvaluated\n    deactivate HR\n    HR --&gt;&gt; LC : HealthReport\n    deactivate HR\n    deactivate LC\nend\nopt command received \n    LC -&gt; HR : LifecycleCommand(command)\n    activate LC\n    activate HR\n    HR -&gt; HR : processCommand()\n    activate HR\n    HR --&gt;&gt; HR : commandProcessed\n    deactivate HR\n    HR -&gt;&gt; PR : command\n    activate PR\n    PR --&gt;&gt; HR : status \n    deactivate PR\n    HR -&gt;&gt; Timer : command\n    activate Timer\n    Timer --&gt;&gt; HR : status \n    deactivate Timer\n    HR -&gt;&gt; FSM : command\n    activate FSM\n    FSM --&gt;&gt; HR : status \n    deactivate FSM\n    HR -&gt;&gt; PC : command\n    activate PC\n    PC --&gt;&gt; HR : status \n    deactivate PC\n    HR -&gt;&gt; OS : command\n    activate OS\n    OS --&gt;&gt; HR : status \n    deactivate OS\n    HR --&gt;&gt; LC : ACK(commandDone)\n    deactivate HR\n    deactivate LC\nend\n@enduml &quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="8AMrYDGJ7CHkdau71c5n-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=20;" vertex="1">
