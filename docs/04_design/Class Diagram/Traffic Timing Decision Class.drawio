  <diagram name="Page-1" id="7WtDz9g_6gvGG25FCcul">
    <mxGraphModel grid="1" page="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle Traffic Timing Decision - Class Diagram\n\nleft to right direction\n\nskinparam shadowing false\nskinparam classAttributeIconSize 0\nskinparam linetype ortho\n\nclass HealthReporter &lt;&lt;Health&gt;&gt; {\n\n- cycleStartTimestampNs : uint64_t\n- cycleFinishTimestampNs : uint64_t\n- executionTimeNs : uint64_t\n- deadlineMs : uint32_t\n- deadlineStatus : DeadlineStatus\n- heartbeat : bool\n\n+ startDecisionCycle() : void\n+ finishDecisionCycle() : void\n\n+ generateHealthReport() : HealthReport\n+ publishHealthReport() : bool\n\n- recordStartTimestamp() : void\n- recordFinishTimestamp() : void\n- calculateExecutionTime() : void\n- evaluateDeadline() : void\n\n}\n\nclass PeriodicService &lt;&lt;RT_Service&gt;&gt; {\n\n- timerFd : int32_t\n- periodMs : uint32_t\n- running : bool\n\n+ initialize() : bool\n+ runDecisionCycle() : void\n+ shutdown() : void\n\n}\n\nclass TrafficDataReceiver &lt;&lt;IPC&gt;&gt; {\n\n- snapshotQueue : SnapshotQueue\n- latestSnapshot : TrafficSnapshot\n- previousSnapshot : TrafficSnapshot\n- snapshotTimeoutMs : uint32_t\n- lastReceiveTimestampNs : uint64_t\n\n+ requestSnapshot() : TrafficSnapshot\n+ validateSnapshot(snapshot : TrafficSnapshot) : bool\n+ getLatestSnapshot() : TrafficSnapshot\n}\n\nclass DecisionEngine &lt;&lt;Algorithm&gt;&gt; {\n- previousPlan : TimingPlan\n- currentScore : DemandScore\n- emergencyActive : bool\n\n+ processTrafficMetrics(snapshot : TrafficSnapshot) : TimingPlan\n+ detectEmergency(snapshot : TrafficSnapshot) : bool\n+ calculateDemandScore(snapshot : TrafficSnapshot) : DemandScore\n+ assignGreenTime(score : DemandScore) : TimingPlan\n+ generateDraftTimingPlan(score : DemandScore) : TimingPlan\n+ setEmergencyFlags(plan : TimingPlan) : TimingPlan\n}\n\nclass ConstraintManager &lt;&lt;Constraint&gt;&gt; {\n- minimumGreenMs : uint32_t\n- maximumGreenMs : uint32_t\n- maximumCycleLengthMs : uint32_t\n- yellowTimeMs : uint32_t\n- allRedTimeMs : uint32_t\n\n- validateCycleLength(plan : TimingPlan) : bool\n- scaleGreenTime(plan : TimingPlan) : TimingPlan\n+ applyTimingConstraints(plan : TimingPlan) : TimingPlan\n}\n\nclass TimingPlanPublisher &lt;&lt;IPC&gt;&gt; {\n- lastPublishedPlan : TimingPlan\n- ackTimeoutMs : uint32_t\n- lastPublishTimestampNs : uint64_t\n\n+ publishTimingPlan(plan : TimingPlan) : bool\n+ publishPreviousTimingPlan() : bool\n+ waitAck() : bool\n}\n\nclass SnapshotQueue &lt;&lt;POSIX_Message_Queue&gt;&gt; {\n- mqDescriptor : mqd_t\n- queueName : char*\n- attributes : mq_attr\n\n+ open() : bool\n+ receive(snapshot : TrafficSnapshot&amp;) : bool\n+ close() : void\n\n}\n\nstruct TrafficSnapshot {\n\n+ frameId : uint64_t\n+ timestamp : uint64_t\n\n+ vehicleCountNS : uint32_t\n+ vehicleCountEW : uint32_t\n\n+ queueLengthNS : float\n+ queueLengthEW : float\n\n+ occupancyNS : float\n+ occupancyEW : float\n\n+ emergencyNS : bool\n+ emergencyEW : bool\n\n}\n\nstruct DemandScore {\n\n+ northSouthScore : float\n+ eastWestScore : float\n+ overallScore : float\n\n}\n\nstruct TimingPlan {\n\n+ planId : uint64_t\n+ generationTimestamp : uint64_t\n\n+ greenNS : uint32_t\n+ greenEW : uint32_t\n\n+ yellowTime : uint32_t\n+ allRedTime : uint32_t\n\n+ cycleLength : uint32_t\n\n+ emergencyNS : bool\n+ emergencyEW : bool\n\n}\n\nPeriodicService *-- TrafficDataReceiver : owns\nPeriodicService *-- DecisionEngine : owns\nPeriodicService *-- ConstraintManager : owns\nPeriodicService *-- TimingPlanPublisher : owns\n\nTrafficDataReceiver --&gt; SnapshotQueue : receives snapshots\n\nDecisionEngine --&gt; ConstraintManager : uses\n\nTrafficDataReceiver --&gt; TrafficSnapshot : stores snapshots\n\nSnapshotQueue ..&gt; TrafficSnapshot : transports \\n snapshots\n\nDecisionEngine ..&gt; TrafficSnapshot : reads\n\nDecisionEngine --&gt; DemandScore : calculates,\\n uses\n\nDecisionEngine --&gt; TimingPlan : creates, stores\n\nConstraintManager ..&gt; TimingPlan : modifies\n\nTimingPlanPublisher --&gt; TimingPlan : sends, stores\n\nPeriodicService *-- HealthReporter : owns\n\nHealthReporter ..&gt; TrafficDataReceiver : monitors\n\nHealthReporter ..&gt; TimingPlanPublisher : monitors\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="okLKwU9X7yECOcnIodeb-1">
