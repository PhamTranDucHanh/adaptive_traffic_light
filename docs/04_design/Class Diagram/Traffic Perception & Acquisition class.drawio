  <diagram id="e1Cj_kDvBntzFgWMnhv5" name="Page-2">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n&#39;skinparam classAttributeIconSize 0\n&#39;skinparam style strictuml\nskinparam BackgroundColor white\nskinparam RoundCorner 8\nskinparam linetype ortho\n\ntitle Class Diagram - Traffic Perception &amp; Acquisition\n\n&#39; ==========================================\n&#39; INTERFACES &amp; ABSTRACT CLASSES\n&#39; ==========================================\ninterface IAnalyzedView {\n    + {abstract} updateLaneView(ctx : FrameContext&amp;) : void\n}\n\ninterface ISnapshotSender {\n    + {abstract} open() : bool\n    + {abstract} send(snapshot : FrameContext&amp;) : void\n    + {abstract} close() : void\n}\n\ninterface ILogger {\n    + {abstract} log(msg : std::string) : void\n    + {abstract} logError(msg : std::string) : void\n}\n\ninterface IStartReport {\n    + {abstract} reportExecutionStart() : void\n}\n\ninterface IEndReport {\n    + {abstract} reportExecutionEnd() : void\n}\n\n&#39; ==========================================\n&#39; STRUCTS &amp; DATA MODELS\n&#39; ==========================================\nstruct AppConfig {\n    + rtspUrl : std::string\n    + inferenceBatchSize : int\n    + frameRate : int\n}\n\nstruct Detection {\n    + box : cv::Rect\n    + classId : int\n    + confidence : float\n}\n\nstruct FrameContext {\n    + frameId : uint64_t\n    + rawImage : cv::Mat\n    + timestamp : uint64_t\n    + detections : std::vector&lt;Detection&gt;\n    + laneMetrics : LaneMetrics\n}\n\n&#39; ==========================================\n&#39; SYSTEM CORE CLASSES\n&#39; ==========================================\nclass PerceptionModule {\n    - configManager : ConfigManager\n    - watchdog : StreamWatchdog\n    - workers : std::vector&lt;StreamWorker*&gt;\n    - pipelineManager : PipelineManager\n    - healthReporter : IHealthReporter*\n    - viewer : IAnalyzedView*\n    - logger : ILogger\n    - logAnalyzer : LogAnalyzer\n    + initModule(configPath : std::string) : bool\n    + startThreads() : void\n    + stopThreads() : void\n}\n\nclass StreamWatchdog &lt;&lt;SCHED_FIFO P90&gt;&gt; {\n    + monitorStreams() : void\n}\n\nclass StreamWorker &lt;&lt;SCHED_FIFO P80&gt;&gt; {\n    - config : AppConfig\n    - queue : SafeFrameQueue&amp;\n    + captureLoop() : void\n}\n\nclass SafeFrameQueue &lt;&lt;Lock-Free&gt;&gt; {\n    - queue : std::atomic&lt;FrameContext*&gt;\n    + push_with_overwrite(ctx : FrameContext&amp;&amp;) : void\n    + pop_non_blocking(ctx : FrameContext&amp;) : bool\n}\n\nclass ConfigManager {\n    - configFile : std::string\n    - cachedConfig : AppConfig\n    + loadConfig() : bool\n    + getConfig() : AppConfig\n}\n\nclass PipelineManager &lt;&lt;SCHED_FIFO P75&gt;&gt; {\n    - isRunning : std::atomic&lt;bool&gt;\n    - pipelineThread : std::thread\n    - inputQueue : SafeFrameQueue&amp;\n    - inferenceEngine : InferenceEngine*\n    - trafficAnalyzer : TrafficAnalyzer*\n    - publisher : SnapshotPublisher*\n    - pipelineLoop() : void\n    + start() : void\n    + stop() : void\n}\n\nclass InferenceEngine {\n    - config : AppConfig\n    - backend : ModelBackend\n    - healthReporter : HealthReporter*\n    + executeInference(ctx : FrameContext&amp;) : void\n}\n\nclass ModelBackend {\n    - modelPath : std::string\n    + loadModel() : bool\n    + predict(img : cv::Mat) : std::vector&lt;Detection&gt;\n}\n\nclass TrafficAnalyzer {\n    - zoneId : int\n    - viewerPtr : IAnalyzedView*\n    + trackAndAnalyze(ctx : FrameContext&amp;) : void\n}\n\nclass OpenCVLanesViewer &lt;&lt;SCHED_FIFO P60&gt;&gt; {\n    - windowName : std::string\n    - periodicThread : std::thread\n    - frameBuffer : DoubleBuffer&lt;FrameContext&gt;\n    - renderLoop() : void\n    + updateLaneView(ctx : FrameContext&amp;) : void\n}\n\nclass SnapshotPublisher {\n    - logger : ILogger*\n    - brokerUrl : std::string\n    - sender : ISnapshotSender*\n    - healthReporter : HealthReporter*\n    - benchmarkBuffer : std::vector&lt;BenchmarkEntry&gt;\n    + broadcastSnapshot(ctx : FrameContext&amp;) : void\n    + logError(errCtx : ErrorCtx) : void\n    + logTelemetry() : void\n}\n\nclass POSIX_MQS_MCRecordSender {\n    - mqDescriptor : int\n    - queueName : std::string\n    + open() : bool\n    + send(snapshot : FrameContext&amp;) : void\n    + close() : void\n}\n\nclass HealthReporter {\n    - startTimes : std::unordered_map&lt;uint64_t, struct timespec&gt;\n    + reportExecutionStart() : void\n    + reportExecutionEnd() : void\n}\n\nclass LogAnalyzer {\n    - logger : ILogger*\n    + analyzeLogs() : void\n    + printResult() : void\n}\n\n&#39; ==========================================\n&#39; RELATIONSHIPS &amp; DEPENDENCIES\n&#39; ==========================================\nPerceptionModule *-- ConfigManager\nPerceptionModule *-- StreamWatchdog\nPerceptionModule *-- \&quot;4\&quot; StreamWorker\nPerceptionModule *-- PipelineManager\nPerceptionModule *-- HealthReporter\nPerceptionModule *-- IAnalyzedView\nPerceptionModule *-- ILogger\nPerceptionModule *-- LogAnalyzer\n\nStreamWatchdog --&gt; \&quot;4\&quot; StreamWorker : \&quot;monitors\&quot;\n\nStreamWorker ..&gt; AppConfig : \&quot;reads\&quot;\nStreamWorker --&gt; SafeFrameQueue : \&quot;pushes data\&quot;\n\nPipelineManager --&gt; SafeFrameQueue : \&quot;pops data\&quot;\nPipelineManager *-- InferenceEngine\nPipelineManager *-- TrafficAnalyzer\nPipelineManager *-- SnapshotPublisher\n\nFrameContext *-- Detection\n\nInferenceEngine *-- ModelBackend\nInferenceEngine ..&gt; AppConfig : \&quot;reads\&quot;\nInferenceEngine o-- IStartReport : \&quot;reports start\&quot;\nInferenceEngine ..&gt; FrameContext : \&quot;enriches\&quot;\n\nTrafficAnalyzer --&gt; IAnalyzedView : \&quot;calls via\&quot;\nTrafficAnalyzer ..&gt; FrameContext : \&quot;enriches\&quot;\n\nOpenCVLanesViewer ..|&gt; IAnalyzedView : \&quot;implements\&quot;\nOpenCVLanesViewer ..&gt; FrameContext : \&quot;consumes (double buffer)\&quot;\n\nSnapshotPublisher --&gt; ISnapshotSender : \&quot;delegates transmission\&quot;\nSnapshotPublisher o-- IEndReport : \&quot;reports end\&quot;\nSnapshotPublisher ..&gt; FrameContext : \&quot;consumes &amp; benchmarks\&quot;\nSnapshotPublisher *.. ILogger : \&quot;logs\&quot;\n\nPOSIX_MQS_MCRecordSender ..|&gt; ISnapshotSender : \&quot;implements\&quot;\n\nILogger --o LogAnalyzer : \&quot;analyzes logs\&quot;\n\nHealthReporter --|&gt; IStartReport\nHealthReporter --|&gt; IEndReport\n\nConfigManager *-- AppConfig\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="2TChAEaM6ZDI5PXk5MQm-507">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry height="545" width="1952.73" as="geometry" />
          </mxCell>
        </UserObject>
