<mxfile host="app.diagrams.net" pages="2">
  <diagram name="Page-1" id="2Kg2-udhUDzqL9zP3IV3">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam classAttributeIconSize 0\nskinparam backgroundColor white\nskinparam roundcorner 5\nskinparam BoxPadding 10\nskinparam linetype ortho\n\ntitle Traffic Perception &amp; Acquisition - Decoupled Pipeline Architecture\n\n&#39; ==========================================\n&#39; CẤU TRÚC DỮ LIỆU PHẲNG\n&#39; ==========================================\nstruct Detection &lt;&lt;struct&gt;&gt; {\n    + Box: cv::Rect\n    + ClassId: int\n    + Confidence: float\n}\n\nstruct FrameContext &lt;&lt;struct&gt;&gt; {\n    + FrameId: int\n    + Frame: cv::Mat\n    + Detections: std::vector&lt;Detection&gt;\n    + LaneId: int\n    + VehicleCount: int\n}\n\nstruct AppConfig &lt;&lt;struct&gt;&gt; {\n    + RtspUrls: std::array&lt;std::string, 4&gt;\n    + ModelPath: std::string\n    + MaxQueueSize: int = 1\n    + TargetFps: int\n}\n\n&#39; ==========================================\n&#39; LAYER 0: THE ORCHESTRATOR\n&#39; ==========================================\nclass PerceptionModule {\n    - ConfigManager: ConfigManager\n    - Watchdog: StreamWatchdog\n    - Workers: std::array&lt;StreamWorker, 4&gt;\n    - Queues: std::array&lt;SafeFrameQueue, 4&gt;\n    - Engine: InferenceEngine\n    - Analyzer: TrafficAnalyzer\n    - Viewer: MultiLaneViewer\n    - Publisher: SnapshotPublisher\n    - Telemetry: TelemetryManager\n    - SnapshotSender: MQSnapshotSender\n    - PipelineHead: PipelineNode*\n    + initModule(configPath: std::string): bool\n    + startThreads(): void\n    + stopThreads(): void\n}\n\n&#39; ==========================================\n&#39; LAYER 1: ACQUISITION &amp; QUEUES\n&#39; ==========================================\nclass ConfigManager {\n    - ConfigFile: std::string\n    - CachedConfig: AppConfig\n    + loadConfig(): bool\n    + getConfig(): AppConfig\n}\n\nclass StreamWorker {\n    - LaneId: int\n    - Config: AppConfig\n    - RtspStream: cv::VideoCapture\n    + initStream(cfg: AppConfig, id: int): bool\n    + producerLoop(queue: SafeFrameQueue&amp;): void\n    + getHealthStatus(): int\n}\n\nclass StreamWatchdog {\n    + monitorHealth(worker: const StreamWorker&amp;): void\n    + recoverStream(worker: StreamWorker&amp;, cfg: AppConfig): void\n}\n\nclass SafeFrameQueue {\n    - Mutex: std::mutex\n    - InternalQueue: std::queue&lt;FrameContext&gt;\n    + enqueue_with_overwrite(ctx: FrameContext&amp;&amp;): void\n    + dequeue_non_blocking(ctx: FrameContext&amp;): bool\n}\n\n&#39; ==========================================\n&#39; LAYER 2: INFERENCE &amp; CORE PIPELINE STAGES\n&#39; ==========================================\nclass ModelBackend {\n    - InternalModelPtr: void*\n    + init(modelPath: std::string): bool\n    + detect(frame: const cv::Mat&amp;): std::vector&lt;Detection&gt;\n}\n\nclass InferenceEngine {\n    - Config: AppConfig\n    - Model: ModelBackend\n    - ActiveQueues: std::array&lt;SafeFrameQueue*, 4&gt;\n    + NextStage: PipelineNode*\n    + consumerRoundRobinLoop(): void\n    + executeInference(ctx: FrameContext&amp;): void\n}\n\nclass TrafficAnalyzer {\n    + ZoneId: int\n    - ViewerPtr: MultiLaneViewer*\n    + initViewer(v: MultiLaneViewer*): void\n    + trackAndAnalyze(ctx: FrameContext&amp;): void\n}\n\nclass SnapshotPublisher {\n    + BrokerUrl: std::string\n    - TelemetryPtr: TelemetryManager*\n    - SenderPtr: ISnapshotSender*\n    + initTelemetry(t: TelemetryManager*): void\n    + initSender(s: ISnapshotSender*): void\n    + broadcastSnapshot(ctx: FrameContext&amp;): void\n}\n\n&#39; Thẻ biến hình (Variant Node) chuẩn ngữ nghĩa Stage\nstruct PipelineNode &lt;&lt;struct&gt;&gt; {\n    + Stage: std::variant&lt;TrafficAnalyzer, SnapshotPublisher&gt;\n    + Next: PipelineNode*\n}\n\n&#39; ==========================================\n&#39; LAYER 3: SINK / LEAF COMPONENTS (Các nhánh phụ ngoài luồng)\n&#39; ==========================================\nclass MultiLaneViewer {\n    + WindowName: std::string\n    + updateLaneView(ctx: FrameContext&amp;): void\n}\n\nclass TelemetryManager {\n    + TotalCycles: int\n    + showTelemetryMetrics(ctx: FrameContext&amp;): void\n}\n\ninterface ISnapshotSender {\n    + open(): bool\n    + send(snapshot: FrameContext&amp;): bool\n    + close(): void\n}\n\nclass MQSnapshotSender &lt;&lt;POSIX_Message_Queue&gt;&gt; {\n    - mqDescriptor : mqd_t\n    - queueName : char*\n    - attributes : mq_attr\n    + open() : bool\n    + send(snapshot : FrameContext&amp;) : bool\n    + close() : void\n}\n\nclass HealthReporter {\n    - signalBuffer: std::vector&lt;bool&gt;\n    + sendStartSignal(): void\n    + sendEndSignal(): void\n}\n\n&#39; ==========================================\n&#39; MA TRẬN MỐI QUAN HỆ CHUẨN KIẾN TRÚC ĐA HÌNH TĨNH\n&#39; ==========================================\nFrameContext *-- Detection : \&quot;contains\&quot;\nConfigManager *-- AppConfig : \&quot;manages\&quot;\n\n&#39; Quyền sở hữu của Orchestrator\nPerceptionModule *-- ConfigManager\nPerceptionModule *-- StreamWatchdog\nPerceptionModule *-- \&quot;4\&quot; StreamWorker\nPerceptionModule *-- \&quot;4\&quot; SafeFrameQueue\nPerceptionModule *-- InferenceEngine\nPerceptionModule *-- TrafficAnalyzer\nPerceptionModule *-- MultiLaneViewer\nPerceptionModule *-- SnapshotPublisher\nPerceptionModule *-- TelemetryManager\nPerceptionModule *-- MQSnapshotSender\n\n&#39; Luồng Config &amp; Đa luồng 4 làn\nConfigManager ..&gt; StreamWorker : \&quot;injects config\&quot;\nConfigManager ..&gt; InferenceEngine : \&quot;injects config\&quot;\nStreamWorker --&gt; AppConfig : \&quot;reads\&quot;\nInferenceEngine --&gt; AppConfig : \&quot;reads\&quot;\nStreamWatchdog ..&gt; StreamWorker : \&quot;monitors\&quot;\nStreamWorker \&quot;1\&quot; --&gt; \&quot;1\&quot; SafeFrameQueue : \&quot;pushes data\&quot;\nInferenceEngine \&quot;1\&quot; o--&gt; \&quot;4\&quot; SafeFrameQueue : \&quot;polls\&quot;\nInferenceEngine *-- ModelBackend : \&quot;owns\&quot;\nInferenceEngine --&gt; HealthReporter : \&quot;depends\&quot;\nTelemetryManager --&gt; HealthReporter : \&quot;depends\&quot;\n\n&#39; --- LUỒNG PIPELINE TUYẾN TÍNH ĐỘC LẬP TUYỆT ĐỐI ---\nInferenceEngine -&gt; PipelineNode : \&quot;triggers pipeline\&quot;\nPipelineNode --&gt; PipelineNode : \&quot;Next\&quot;\nPipelineNode o-- TrafficAnalyzer : \&quot;«variant»\&quot;\nPipelineNode o-- SnapshotPublisher : \&quot;«variant»\&quot;\n\n&#39; --- CÁC KẾT NỐI SINK ĐẦU RA PHỤ ---\nTrafficAnalyzer --&gt; MultiLaneViewer : \&quot;calls via IAnalyzedView\&quot;\nSnapshotPublisher --&gt; TelemetryManager : \&quot;calls via ITelemetry\&quot;\n\n&#39; =========================================================\n&#39; 🌟 KẾT NỐI ĐẦU RA SNAPSHOT GIAO TIẾP QUA INTERFACE\n&#39; =========================================================\nMQSnapshotSender .up.|&gt; ISnapshotSender : \&quot;implements\&quot;\nSnapshotPublisher o--&gt; ISnapshotSender : \&quot;delegates transmission to\&quot;\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="GoNQbMfknUsegqVCESZ7-741">
