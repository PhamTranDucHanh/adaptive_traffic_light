  <diagram id="i6LbPaipgGcD5Bv1dnUm" name="Page-2">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle Traffic Signal Controller - Class Diagram\n\n&#39;========================================================\n&#39; Enums &amp; Data structures\n&#39;========================================================\nenum PhaseId {\n  NS_GREEN\n  YELLOW\n  ALL_RED\n  EW_GREEN\n}\n\nclass Phase {\n  + phaseId : PhaseId\n  + durationMs : uint32_t\n}\n\nclass PlanData {\n  + sourcePlanId : uint64_t\n  + phases : Phase[MAX_PHASES]\n  + phaseCount : uint8_t\n  + totalCycleMs : uint32_t\n  + isEmergencyNS : bool\n  + isEmergencyEW : bool\n  + receivedAt : uint64_t\n}\n\nstruct SignalOutput {\n  + timestamp : uint64_t\n}\n\nclass SignalDisplay\n\nstruct DataCollect {\n  + cycleId : uint64_t\n  + sourcePlanId : uint64_t\n  + nsGreenDurationMs : uint32_t\n  + ewGreenDurationMs : uint32_t\n  + yellowDurationMs : uint32_t\n  + allRedDurationMs : uint32_t\n  + isEmergencyCycle : bool\n  + samples : SignalOutput[MAX_SAMPLES]\n  + sampleCount : uint8_t\n}\n\nstruct LogEntry {\n  + cycleData : DataCollect\n  + loggedTimestamp : uint64_t\n}\n\n&#39;========================================================\n&#39; Components\n&#39;========================================================\nclass PlanReceiver {\n  - validPlanResult : bool\n  - translatePlan() : PlanData\n  + receivePlan(plan : PlanData) : void\n  + validatePlan() : bool\n  + accept() : void\n  + reject() : void\n  + forwardPlan() : PlanData\n}\n\nclass SignalFSMEngine {\n  - remainingTimeMs : uint32_t\n  - currentPhaseIndex : uint8_t\n  - currentPlan : PlanData\n  - isEmergencyNS : bool\n  - isEmergencyEW : bool\n  - hasNewPlan : bool\n  - fsm() : void\n  + processTick() : void\n  + sendHeartbeat() : HealthStatus\n}\n\nclass OutputSimulator {\n  + receiveSignalDisplay(display : SignalDisplay) : void\n  + formatConsole() : void\n  + sendToParticipants() : void\n}\n\nclass LatencyCollector {\n  - sampleBuffer : SignalOutput[MAX_SAMPLES]\n  + collectTimestamp(ts : SignalOutput) : void\n  + computeLatency() : void\n  + packageData() : DataCollect\n  + sendToLogger(l : EventLogger) : void\n}\n\nclass EventLogger {\n  + receiveDataCollect(data : DataCollect) : void\n  + writeLogEntry() : LogEntry\n  + sendToAnalytics(a : Analytics) : void\n}\n\nclass Analytics {\n  + receiveLogEntry(entry : LogEntry) : void\n  + computeStatistics() : void\n  + buildHistogram() : void\n}\n\n&#39;========================================================\n&#39; Relationships - structural (composition)\n&#39;========================================================\nPlanData *-- \&quot;0..MAX_PHASES\&quot; Phase : phases[]\nPhase --&gt; PhaseId\nSignalFSMEngine *-- PlanData : currentPlan\nLatencyCollector *-- \&quot;0..MAX_SAMPLES\&quot; SignalOutput : sampleBuffer\nDataCollect *-- \&quot;0..MAX_SAMPLES\&quot; SignalOutput : samples[]\nLogEntry *-- DataCollect : cycleData\n\nnote right of PlanData\nThe Phase array is an internal\npre-translated phase sequence\nexecuted by the FSM Engine.\nNormal mode: 6 phases.\nEmergency mode: disabled phases\nare removed, leaving only active ones.\nend note\n\n&#39;========================================================\n&#39; Relationships - behavioral (sends / creates)\n&#39;========================================================\nPlanReceiver --&gt; SignalFSMEngine : sends PlanData\nPlanReceiver ..&gt; PlanData : creates\n\nSignalFSMEngine --&gt; LatencyCollector : sends SignalOutput\nSignalFSMEngine --&gt; OutputSimulator : sends SignalDisplay\nSignalFSMEngine ..&gt; SignalOutput : creates every tick\nSignalFSMEngine ..&gt; SignalDisplay : creates every tick\n\nOutputSimulator ..&gt; SignalDisplay : consumes\n\nLatencyCollector ..&gt; DataCollect : creates\nLatencyCollector --&gt; EventLogger : sends DataCollect\n\nEventLogger ..&gt; LogEntry : creates\nEventLogger --&gt; Analytics : sends LogEntry\n\nAnalytics ..&gt; LogEntry : consumes for statistics\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="5ASszpI0525-J-eUloIe-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=20;" vertex="1">
            <mxGeometry height="1300" width="1156.05" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Traffic Signal Controller - Class Diagram" plantUmlId="cltitle_2" plantUmlBaseStyle="text;html=1;fillColor=none;strokeColor=none;fontSize=14;fontStyle=1;fontColor=#000000;align=center;verticalAlign=middle;" plantUmlBaseValue="Traffic Signal Controller - Class Diagram" id="5ASszpI0525-J-eUloIe-2">
          <mxCell parent="5ASszpI0525-J-eUloIe-1" style="text;html=1;fillColor=none;strokeColor=none;fontSize=14;fontStyle=1;fontColor=#000000;align=center;verticalAlign=middle;" vertex="1">
            <mxGeometry height="24" width="293.03192" x="624.93868" y="-230" as="geometry" />
